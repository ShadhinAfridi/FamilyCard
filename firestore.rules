rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write to family_cards collection and members subcollection for the enumerator assistant app
    match /family_cards/{docId} {
      allow read, write: if true;

      match /members/{memberId} {
        allow read, write: if true;
      }
    }

    // Cross-device room messaging & live NID/summary data sharing channels
    match /room_channels/{roomCode} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Diagnostic telemetry, OCR/DeepSeek repair traces & error logs
    match /fc_error_logs/{logId} {
      allow read, write: if true;
    }

    match /family_cards/{docId}/logs/{logId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
