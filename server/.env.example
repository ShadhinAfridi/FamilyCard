# Port for server (default 3000)
PORT=3000

# Google Gemini API Key for NID OCR
# Get one for free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional DeepSeek API Key (deepseek-flash multimodal OCR backup/primary)
# Get one at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
