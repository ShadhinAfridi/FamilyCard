rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write to family_cards collection and members subcollection for the enumerator assistant app
    match /family_cards/{docId} {
      allow read, write: if true;

      match /members/{memberId} {
        allow read, write: if true;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
