{
  "manifest_version": 3,
  "name": "Family Card NID AI Auto-Filler",
  "version": "2.0.0",
  "description": "AI OCR Scanner (Gemini + DeepSeek Cost Tracker), Step 2 Personal Info Processor, Section 3-9 Defaults & Cross-Device Room Messenger for fc.bhata.gov.bd",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://fc.bhata.gov.bd/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Family Card NID Auto-Filler Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fc.bhata.gov.bd/*"
      ],
      "js": [
        "socket.io.min.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ]
}
